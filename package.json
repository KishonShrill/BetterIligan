{
    "name": "betteriligan",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "packageManager": "npm@11.16.0",
    "scripts": {
        "prebuild": "npm run cf-typegen",
        "build:next": "next build",
        "dev:next": "next dev --webpack",
        "start:next": "next start",
        "lint": "eslint",
        "prepare": "husky",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "generate-og": "tsx scripts/generate-og-images.tsx",
        "generate-og:force": "tsx scripts/generate-og-images.tsx --force",
        "dev": "vinext dev --port 3001",
        "build": "vinext build",
        "start": "wrangler dev --config dist/server/wrangler.json",
        "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
    },
    "dependencies": {
        "@bettergov/kapwa": "^1.2.4",
        "@vinext/cloudflare": "^1.0.0-beta.6",
        "clsx": "^2.1.1",
        "leaflet": "^1.9.4",
        "neverthrow": "^8.2.0",
        "next": "16.2.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-google-recaptcha": "^3.1.0",
        "react-hot-toast": "^2.6.0",
        "react-leaflet": "^5.0.0",
        "react-server-dom-webpack": "^19.2.8",
        "recharts": "^2.15.0",
        "tailwind-merge": "^3.6.0",
        "vinext": "^1.0.0-beta.6",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.52.1",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@tailwindcss/postcss": "^4",
        "@types/geojson": "^7946.0.16",
        "@types/leaflet": "^1.9.21",
        "@types/next": "^8.0.7",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/react-google-recaptcha": "^2.1.9",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitejs/plugin-rsc": "^0.5.34",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "exceljs": "^4.4.0",
        "husky": "^9.1.7",
        "satori": "^0.28.1",
        "sharp": "^0.35.3",
        "tailwindcss": "^4",
        "tsx": "^4.23.1",
        "typescript": "^5",
        "vite": "^8.2.1",
        "wrangler": "^4.95.0"
    }
}
